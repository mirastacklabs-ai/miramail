<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- For any nested helper executable or framework (MiraMail currently ships none: no sidecars). Child processes must
       carry app-sandbox + inherit, nothing else. Applied by scripts/build-mas.sh to everything inside the bundle except the main binary. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
